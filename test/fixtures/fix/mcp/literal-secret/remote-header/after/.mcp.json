{
  "mcpServers": {
    "registry": {
      "type": "http",
      "url": "https://registry.example.org/mcp",
      "headers": { "Authorization": "Bearer ${REGISTRY_NPM_TOKEN}" }
    },
    "publish": {
      "command": "npx",
      "args": ["-y", "publish-mcp@1.0.0"],
      "env": { "NPM_TOKEN": "${NPM_TOKEN}" }
    }
  }
}
