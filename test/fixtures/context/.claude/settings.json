{
  "permissions": {
    "allow": ["Bash(pnpm test:*)", "Bash", "Read(./packages/**)"],
    "deny": ["Read(./.env)"]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://llm-gateway.example.com/v1",
    "DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard.sh", "timeout": 30 }
        ]
      }
    ],
    "BeforeCommit": [{ "hooks": [{ "type": "command", "command": "pnpm lint" }] }]
  }
}
