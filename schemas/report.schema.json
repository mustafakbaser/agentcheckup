{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mustafakbaser/agentcheckup/main/schemas/report.schema.json",
  "title": "agentcheckup JSON report",
  "description": "Output of `agentcheckup --format json`. Positions are 1-based; columns count UTF-16 code units. Paths are POSIX and relative to the scan root. Strings are data from the scanned repository: treat them as untrusted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "ruleset",
    "fingerprintVersion",
    "targets",
    "artifacts",
    "findings",
    "score",
    "summary",
    "rules",
    "skipped",
    "unresolvedSymlinks",
    "ruleFailures",
    "configWarnings"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this report shape. Incremented on any incompatible change.",
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "ruleset": {
      "description": "Calendar-versioned rule set, e.g. 2026.10.",
      "type": "string",
      "minLength": 1
    },
    "fingerprintVersion": {
      "description": "Version of the scheme that computes each finding's `fingerprint`. `--baseline` refuses a report with another version, and reads a report without this field as version 1.",
      "const": 2
    },
    "targets": {
      "description": "Platforms the scan targeted, sorted.",
      "type": "array",
      "items": { "$ref": "#/$defs/platformId" },
      "uniqueItems": true
    },
    "artifacts": {
      "description": "Recognized agent configuration files, sorted by path.",
      "type": "array",
      "items": { "$ref": "#/$defs/artifactSummary" }
    },
    "findings": {
      "description": "Sorted by path, line, column, rule id. Includes suppressed findings, marked with `suppressed`.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "score": { "$ref": "#/$defs/scoreReport" },
    "summary": {
      "description": "Counts of unsuppressed findings by severity, and of suppressed findings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "infos", "suppressed"],
      "properties": {
        "errors": { "$ref": "#/$defs/count" },
        "warnings": { "$ref": "#/$defs/count" },
        "infos": { "$ref": "#/$defs/count" },
        "suppressed": { "$ref": "#/$defs/count" }
      }
    },
    "rules": {
      "description": "Metadata of every rule that ran, plus the inline-directive rules, sorted by id.",
      "type": "array",
      "items": { "$ref": "#/$defs/ruleMeta" }
    },
    "skipped": {
      "description": "Files that were found but not checked.",
      "type": "array",
      "items": { "$ref": "#/$defs/skippedEntry" }
    },
    "unresolvedSymlinks": {
      "description": "Symlinks that were not followed.",
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedSymlink" }
    },
    "ruleFailures": {
      "description": "Rules that crashed. Non-empty means the results are incomplete.",
      "type": "array",
      "items": { "$ref": "#/$defs/ruleFailure" }
    },
    "configWarnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pathBase": {
      "description": "The directory prefix added to every path so that paths read relative to where the command ran (POSIX, no trailing slash). Absent or empty when paths are relative to the scanned directory. `--baseline` removes it before comparing two reports.",
      "type": "string"
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "context": { "$ref": "#/$defs/contextReport" },
    "baseline": { "$ref": "#/$defs/baselineDiff" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "platformId": {
      "enum": ["claude-code", "codex", "cursor", "copilot", "gemini", "windsurf", "cline"]
    },
    "severity": { "enum": ["info", "warn", "error"] },
    "category": {
      "enum": ["loading", "budget", "portability", "correctness", "risk", "clarity"]
    },
    "artifactKind": {
      "enum": [
        "agents-md",
        "agents-override-md",
        "claude-md",
        "claude-local-md",
        "claude-rule",
        "claude-agent",
        "claude-command",
        "claude-settings",
        "claude-plugin-manifest",
        "skill",
        "cursor-rule",
        "cursor-rule-md",
        "cursor-legacy-rules",
        "cursor-hooks",
        "cursor-mcp",
        "copilot-instructions",
        "copilot-path-instructions",
        "gemini-md",
        "gemini-settings",
        "mcp-json",
        "codex-hooks",
        "windsurf-rule",
        "windsurf-legacy-rules",
        "cline-rule",
        "imported-file"
      ]
    },
    "grade": { "enum": ["A", "B", "C", "D", "F"] },
    "path": {
      "description": "POSIX path relative to the scan root.",
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": {
          "description": "1-based, in UTF-16 code units.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "range": {
      "description": "`end` is exclusive: the position just after the last character.",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "artifactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "readers"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "$ref": "#/$defs/artifactKind" },
        "readers": {
          "description": "Platforms that read this kind of file.",
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        }
      }
    },
    "relatedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "message"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "message": { "type": "string" },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "fixClass": {
      "description": "`safe`: deterministic, one correct form, applied by `agentcheckup fix --write`. `review`: applied only with `--write --review` or when accepted in `-i`. A finding without a fix needs a manual change.",
      "enum": ["safe", "review"]
    },
    "textEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "text"],
      "properties": {
        "offset": {
          "description": "0-based offset into the decoded text (BOM removed), in UTF-16 code units.",
          "type": "integer",
          "minimum": 0
        },
        "length": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "fileChange": {
      "description": "One change to one file. `edit`: text edits to an existing file. `create`: a new file; the path must not exist. `rename`: moves a file and never overwrites. `encoding`: re-encodes the file as UTF-8 without a byte order mark.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "edits"],
          "properties": {
            "kind": { "const": "edit" },
            "path": { "$ref": "#/$defs/path" },
            "edits": {
              "description": "Offsets index the text before this change. Edits do not overlap.",
              "type": "array",
              "items": { "$ref": "#/$defs/textEdit" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "text"],
          "properties": {
            "kind": { "const": "create" },
            "path": { "$ref": "#/$defs/path" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "rename" },
            "from": { "$ref": "#/$defs/path" },
            "to": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "to", "bom"],
          "properties": {
            "kind": { "const": "encoding" },
            "path": { "$ref": "#/$defs/path" },
            "to": { "const": "utf-8" },
            "bom": { "const": false }
          }
        }
      ]
    },
    "fix": {
      "description": "A repair for the finding. Preview it with `agentcheckup fix`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "title", "changes"],
      "properties": {
        "id": {
          "description": "`<rule id>#<variant>`, stable across runs.",
          "type": "string",
          "minLength": 1
        },
        "class": { "$ref": "#/$defs/fixClass" },
        "title": { "type": "string", "minLength": 1 },
        "changes": {
          "description": "Applied in order. A change after a rename names the file by its new path.",
          "type": "array",
          "items": { "$ref": "#/$defs/fileChange" },
          "minItems": 1
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "warning": {
          "description": "A banner to show before and after the fix.",
          "type": "string"
        },
        "alternatives": {
          "description": "Other fixes for the same finding, offered by `agentcheckup fix -i`.",
          "type": "array",
          "items": { "$ref": "#/$defs/fix" }
        }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "enum": ["inline", "config"] },
        "reason": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "severity",
        "category",
        "message",
        "path",
        "range",
        "related",
        "platforms",
        "fingerprint"
      ],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "$ref": "#/$defs/category" },
        "message": { "type": "string" },
        "path": { "$ref": "#/$defs/path" },
        "range": { "$ref": "#/$defs/range" },
        "related": { "type": "array", "items": { "$ref": "#/$defs/relatedLocation" } },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "fingerprint": {
          "description": "`<hash>:<occurrence>`. Stable across lines inserted above and reformatting: in a JSON file the hash covers the JSON path and canonical value the finding points at, elsewhere the normalized text of its line. See `fingerprintVersion`.",
          "type": "string",
          "pattern": "^[0-9a-f]+:[1-9][0-9]*$"
        },
        "fix": { "$ref": "#/$defs/fix" },
        "guidance": {
          "description": "A manual step that the message does not already state.",
          "type": "string"
        },
        "suppressed": { "$ref": "#/$defs/suppression" },
        "baseline": {
          "description": "Set when the scan ran with `--baseline`: `new` when no baseline finding is left to match the fingerprint, otherwise `unchanged`.",
          "enum": ["new", "unchanged"]
        }
      }
    },
    "categoryTally": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "infos"],
      "properties": {
        "errors": { "$ref": "#/$defs/count" },
        "warnings": { "$ref": "#/$defs/count" },
        "infos": { "$ref": "#/$defs/count" }
      }
    },
    "scoreReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "score", "grade", "capped", "categories", "artifacts"],
      "properties": {
        "formula": {
          "description": "Version of the scoring formula (docs/scoring.md).",
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "description": "0 to 100, or null when no agent configuration files were found.",
          "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }]
        },
        "grade": {
          "oneOf": [{ "$ref": "#/$defs/grade" }, { "type": "null" }]
        },
        "capped": {
          "description": "True when an unsuppressed risk error capped the score.",
          "type": "boolean"
        },
        "categories": {
          "description": "Unsuppressed findings per category.",
          "type": "object",
          "additionalProperties": false,
          "required": ["loading", "budget", "portability", "correctness", "risk", "clarity"],
          "properties": {
            "loading": { "$ref": "#/$defs/categoryTally" },
            "budget": { "$ref": "#/$defs/categoryTally" },
            "portability": { "$ref": "#/$defs/categoryTally" },
            "correctness": { "$ref": "#/$defs/categoryTally" },
            "risk": { "$ref": "#/$defs/categoryTally" },
            "clarity": { "$ref": "#/$defs/categoryTally" }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "score"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "ruleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "checked", "status"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "checked": {
          "description": "ISO date when the behavior was last checked against this source.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": { "enum": ["verified", "unverified"] }
      }
    },
    "ruleMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rationale",
        "category",
        "severity",
        "appliesTo",
        "platforms",
        "sources",
        "since"
      ],
      "properties": {
        "id": {
          "description": "`<family>/<kebab-name>`. Stable, never reused.",
          "type": "string",
          "minLength": 1
        },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "description": "Markdown.", "type": "string" },
        "category": { "$ref": "#/$defs/category" },
        "severity": {
          "$ref": "#/$defs/severity",
          "description": "Default severity. A finding may override it."
        },
        "appliesTo": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactKind" },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleSource" },
          "minItems": 1
        },
        "since": { "description": "Rule set version that introduced the rule.", "type": "string" },
        "fix": {
          "description": "Present when the rule can attach a fix: the classes its fixes may have, and what they do.",
          "type": "object",
          "additionalProperties": false,
          "required": ["classes", "summary"],
          "properties": {
            "classes": {
              "type": "array",
              "items": { "$ref": "#/$defs/fixClass" },
              "minItems": 1,
              "uniqueItems": true
            },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "skippedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "reason": {
          "enum": [
            "too-large",
            "binary",
            "special-file",
            "unreadable",
            "file-limit",
            "byte-limit",
            "depth-limit",
            "import-limit"
          ]
        },
        "size": { "description": "Size in bytes, when known.", "type": "integer", "minimum": 0 }
      }
    },
    "unresolvedSymlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "problem"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "target": { "description": "The link text as stored on disk.", "type": "string" },
        "problem": { "enum": ["outside-root", "broken", "not-a-regular-file"] }
      }
    },
    "ruleFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "message"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "relativePath": {
      "description": "POSIX path relative to the scan root. Empty for the root itself.",
      "type": "string"
    },
    "contextAgent": {
      "description": "Agents with a load model, in platform order.",
      "enum": ["claude-code", "codex", "cursor"]
    },
    "loadRole": {
      "enum": [
        "instructions",
        "import",
        "rule",
        "skill",
        "subagent",
        "command",
        "mcp-server",
        "hook"
      ]
    },
    "loadTrigger": {
      "description": "When the agent adds the entry to the model's context. `unknown`: the agent reads the file, but when is not documented.",
      "enum": ["startup", "on-path", "model-selected", "manual", "on-approval", "unknown"]
    },
    "certainty": {
      "description": "How a loading claim is backed. Text output marks `unverified` with \"?\".",
      "enum": ["documented", "source-code", "unverified"]
    },
    "sourceKeys": {
      "description": "Keys into `context.sources`, sorted.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "chars", "tokens"],
      "properties": {
        "bytes": { "description": "Size of the file on disk.", "$ref": "#/$defs/count" },
        "chars": {
          "description": "Code points the agent receives after documented transforms.",
          "$ref": "#/$defs/count"
        },
        "tokens": {
          "description": "Estimate: `ceil(chars / 4)`. Never drives a finding or the score.",
          "$ref": "#/$defs/count"
        }
      }
    },
    "loadEntry": {
      "description": "One thing the agent loads, or may load once its trigger fires.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "trigger", "path", "realPath", "certainty", "evidence"],
      "properties": {
        "id": {
          "description": "`<role>:<path>` or `<role>:<path>#<name>`. Unique within a plan.",
          "type": "string",
          "minLength": 1
        },
        "role": { "$ref": "#/$defs/loadRole" },
        "trigger": { "$ref": "#/$defs/loadTrigger" },
        "position": {
          "description": "1-based assembly order of startup context. Startup entries only.",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "description": "The path as the agent reaches it; may be a symlink alias of `realPath`.",
          "$ref": "#/$defs/path"
        },
        "realPath": { "$ref": "#/$defs/path" },
        "name": { "type": "string" },
        "via": {
          "description": "For imports: the files that led here, root instruction file first.",
          "type": "array",
          "items": { "$ref": "#/$defs/path" }
        },
        "patterns": {
          "description": "For `on-path` entries: the globs, or the directory, that trigger loading, as written.",
          "type": "array",
          "items": { "type": "string" }
        },
        "size": {
          "description": "What the entry adds to context. For a skill, its listing text.",
          "$ref": "#/$defs/size"
        },
        "deferred": {
          "description": "For a skill: the body, loaded only when the skill is used.",
          "$ref": "#/$defs/size"
        },
        "truncated": {
          "description": "Set when a limit cuts the file: the byte where the cut falls and its line.",
          "type": "object",
          "additionalProperties": false,
          "required": ["atByte", "line"],
          "properties": {
            "atByte": { "$ref": "#/$defs/count" },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        "inventoryId": {
          "description": "For MCP servers and hooks: the id of the matching inventory item.",
          "type": "string",
          "minLength": 1
        },
        "certainty": { "$ref": "#/$defs/certainty" },
        "evidence": { "$ref": "#/$defs/sourceKeys" }
      }
    },
    "skipCode": {
      "enum": [
        "shadowed-by-claude-md",
        "shadowed-by-override",
        "over-byte-budget",
        "empty-override",
        "blank-file",
        "not-mdc",
        "no-frontmatter",
        "invalid-frontmatter",
        "bom",
        "no-description",
        "invalid-subagent",
        "import-unresolved",
        "import-too-deep",
        "import-outside-root",
        "url-without-type",
        "unknown-event",
        "invalid-json",
        "not-utf8",
        "case-mismatch",
        "materialized-symlink",
        "not-read"
      ]
    },
    "skippedLoad": {
      "description": "A file or item the agent would consider but skips.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "path", "code", "certainty", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/loadRole" },
        "path": { "$ref": "#/$defs/path" },
        "name": { "type": "string" },
        "code": { "$ref": "#/$defs/skipCode" },
        "ruleId": {
          "description": "The loading rule whose finding reports this skip. Absent only for `not-read`.",
          "type": "string",
          "minLength": 1
        },
        "size": {
          "description": "What the agent would receive if it loaded the file.",
          "$ref": "#/$defs/size"
        },
        "fix": {
          "description": "The class of the fix on the finding of `ruleId` on `path`, when it has one.",
          "$ref": "#/$defs/fixClass"
        },
        "certainty": { "$ref": "#/$defs/certainty" },
        "evidence": { "$ref": "#/$defs/sourceKeys" }
      }
    },
    "outOfScope": {
      "description": "A file the plan leaves out on purpose.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "because"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "because": {
          "enum": ["below-start-dir", "other-agent-plugin", "payload-folder", "documentation"]
        }
      }
    },
    "assumption": {
      "description": "A setting the repository cannot show, stated so that the reader can check it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "origin", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] },
        "origin": { "enum": ["default", "rule-option", "repository", "flag"] },
        "evidence": { "$ref": "#/$defs/sourceKeys" }
      }
    },
    "hiddenScope": {
      "description": "A scope outside the repository that can add to the plan. Listed, never read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "locations", "roles"],
      "properties": {
        "scope": { "enum": ["managed", "user", "global", "team", "account", "plugin"] },
        "locations": {
          "description": "Display text such as `~/.claude/CLAUDE.md`. Never resolved or read.",
          "type": "array",
          "items": { "type": "string" }
        },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/loadRole" }, "uniqueItems": true }
      }
    },
    "limitUsage": {
      "description": "How much of a documented limit the repository uses.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "unit", "limit", "used", "subject", "effect", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "unit": {
          "description": "`levels`: directory levels below a search root. `directories`: directories a search visits.",
          "enum": ["bytes", "chars", "lines", "hops", "levels", "directories", "context-fraction"]
        },
        "limit": {
          "description": "Null when the limit depends on the model's context window and none was given.",
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "used": { "type": "number", "minimum": 0 },
        "subject": {
          "description": "What the usage is measured on, always a path: a file, a directory, or for a group of files (Codex's AGENTS.md chain, a skills listing) the working directory it is computed for. Empty for the scan root. With `key`, identifies the usage.",
          "$ref": "#/$defs/relativePath"
        },
        "label": {
          "description": "Words for a subject that stands for a group of files, such as `AGENTS.md chain`. Display text only, never a path.",
          "type": "string",
          "minLength": 1
        },
        "effect": { "enum": ["skips", "truncates", "shortens", "advice"] },
        "evidence": { "$ref": "#/$defs/sourceKeys" }
      }
    },
    "loadPlan": {
      "description": "What one agent loads for a session started in `cwd`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "cwd",
        "entries",
        "skipped",
        "outOfScope",
        "assumptions",
        "hidden",
        "limits",
        "totals",
        "incomplete"
      ],
      "properties": {
        "agent": { "$ref": "#/$defs/contextAgent" },
        "cwd": {
          "description": "Working directory of the session. Empty for the scan root.",
          "$ref": "#/$defs/relativePath"
        },
        "entries": {
          "description": "Sorted by position, trigger, path, id.",
          "type": "array",
          "items": { "$ref": "#/$defs/loadEntry" }
        },
        "skipped": {
          "description": "Sorted by path, id.",
          "type": "array",
          "items": { "$ref": "#/$defs/skippedLoad" }
        },
        "outOfScope": {
          "description": "Sorted by path.",
          "type": "array",
          "items": { "$ref": "#/$defs/outOfScope" }
        },
        "assumptions": {
          "description": "Sorted by key.",
          "type": "array",
          "items": { "$ref": "#/$defs/assumption" }
        },
        "hidden": { "type": "array", "items": { "$ref": "#/$defs/hiddenScope" } },
        "limits": {
          "description": "Sorted by key, subject.",
          "type": "array",
          "items": { "$ref": "#/$defs/limitUsage" }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "onDemand"],
          "properties": {
            "startup": { "description": "Context at session start.", "$ref": "#/$defs/size" },
            "onDemand": {
              "description": "The most that other triggers can add.",
              "$ref": "#/$defs/size"
            }
          }
        },
        "incomplete": {
          "description": "Parts that could not be analyzed, so entries may be missing: `markdown-budget:<path>`, `unparsed:<path>`, `unread:<path>`.",
          "type": "array",
          "items": { "type": "string" }
        },
        "ignored": {
          "description": "How many files the plan leaves out because the configuration's `ignore` matches them. The agent may still load them. Absent when none.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "matrixCell": {
      "description": "`not-read`: the agent does not read this file (shown as \"—\").",
      "enum": [
        "startup",
        "on-path",
        "start-dir",
        "listed",
        "model-selected",
        "manual",
        "partial",
        "skipped",
        "unknown",
        "not-read"
      ]
    },
    "contextReport": {
      "description": "Load plans: what each agent loads (`agentcheckup context`, or a scan with `--context`).",
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "sources", "plans"],
      "properties": {
        "agents": {
          "description": "In platform order. Matrix cell `i` belongs to agent `i`.",
          "type": "array",
          "items": { "$ref": "#/$defs/contextAgent" },
          "uniqueItems": true
        },
        "sources": {
          "description": "Every source cited by `evidence`, by key, sorted.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ruleSource" }
        },
        "plans": {
          "description": "Sorted by agent, then cwd.",
          "type": "array",
          "items": { "$ref": "#/$defs/loadPlan" }
        },
        "matrix": {
          "description": "File-by-agent matrix, with `--matrix`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "rows": {
              "description": "Sorted by path.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "kind", "cells"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "kind": { "$ref": "#/$defs/artifactKind" },
                  "cells": { "type": "array", "items": { "$ref": "#/$defs/matrixCell" } }
                }
              }
            }
          }
        }
      }
    },
    "packageSpec": {
      "description": "How an MCP server's code is fetched.",
      "type": "object",
      "additionalProperties": false,
      "required": ["launcher", "pin"],
      "properties": {
        "launcher": {
          "enum": [
            "npx",
            "pnpm-dlx",
            "bunx",
            "yarn-dlx",
            "uvx",
            "pipx",
            "docker",
            "local",
            "unknown"
          ]
        },
        "ecosystem": { "enum": ["npm", "pypi", "oci"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "pin": { "enum": ["exact", "digest", "range", "tag", "none", "local", "unknown"] }
      }
    },
    "mcpServerItem": {
      "description": "One MCP server entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "line",
        "platforms",
        "digest",
        "name",
        "transport",
        "envKeys",
        "headerKeys",
        "status"
      ],
      "properties": {
        "id": { "description": "`mcp:<file>#<name>`.", "type": "string", "minLength": 1 },
        "file": {
          "description": "The config file that declares the item.",
          "$ref": "#/$defs/path"
        },
        "line": { "type": "integer", "minimum": 1 },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "digest": {
          "description": "Hash of the redacted entry. The same id with another digest: the item changed.",
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "name": { "type": "string" },
        "transport": { "enum": ["stdio", "http", "sse", "ws", "unknown"] },
        "declaredType": { "description": "The `type` value as written.", "type": "string" },
        "command": { "type": "string" },
        "args": {
          "description": "Secret-looking arguments are redacted.",
          "type": "array",
          "items": { "type": "string" }
        },
        "package": { "$ref": "#/$defs/packageSpec" },
        "url": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "tls", "loopback"],
          "properties": {
            "origin": {
              "description": "URL origin only, never the path or query.",
              "type": "string"
            },
            "tls": { "type": "boolean" },
            "loopback": { "type": "boolean" }
          }
        },
        "envKeys": {
          "description": "Names only, never values.",
          "type": "array",
          "items": { "type": "string" }
        },
        "headerKeys": {
          "description": "Names only, never values.",
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "description": "What each agent that reads `file` does with the server.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/platformId" },
          "additionalProperties": { "enum": ["loads", "needs-approval", "skipped"] }
        }
      }
    },
    "hookItem": {
      "description": "One hook command.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "line",
        "platforms",
        "digest",
        "event",
        "known",
        "failsOpen",
        "remoteScript"
      ],
      "properties": {
        "id": {
          "description": "`hook:<file>#<event>:<digest of command>`, plus an occurrence number for repeats.",
          "type": "string",
          "minLength": 1
        },
        "file": {
          "description": "The config file that declares the item.",
          "$ref": "#/$defs/path"
        },
        "line": { "type": "integer", "minimum": 1 },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "digest": {
          "description": "Hash of the redacted entry. The same id with another digest: the item changed.",
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "event": { "type": "string" },
        "known": {
          "description": "False when the event is not documented, so the hook never runs.",
          "type": "boolean"
        },
        "matcher": { "type": "string" },
        "type": { "type": "string" },
        "command": { "type": "string" },
        "script": {
          "description": "The repository script the command runs, when it can be told.",
          "type": "string"
        },
        "failsOpen": {
          "description": "True when an error or timeout lets the action go ahead.",
          "type": "boolean"
        },
        "remoteScript": {
          "description": "True when the command downloads and runs a script.",
          "type": "boolean"
        }
      }
    },
    "permissionItem": {
      "description": "One permission value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "line",
        "platforms",
        "digest",
        "key",
        "value",
        "broad",
        "effective"
      ],
      "properties": {
        "id": { "description": "`perm:<file>#<key>=<value>`.", "type": "string", "minLength": 1 },
        "file": {
          "description": "The config file that declares the item.",
          "$ref": "#/$defs/path"
        },
        "line": { "type": "integer", "minimum": 1 },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "digest": {
          "description": "Hash of the redacted entry. The same id with another digest: the item changed.",
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "broad": { "description": "True when the value grants wide access.", "type": "boolean" },
        "effective": {
          "description": "False when the agent ignores the value where it is set.",
          "type": "boolean"
        }
      }
    },
    "envItem": {
      "description": "One environment override.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "line", "platforms", "digest", "key", "class"],
      "properties": {
        "id": { "description": "`env:<file>#<key>`.", "type": "string", "minLength": 1 },
        "file": {
          "description": "The config file that declares the item.",
          "$ref": "#/$defs/path"
        },
        "line": { "type": "integer", "minimum": 1 },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformId" },
          "uniqueItems": true
        },
        "digest": {
          "description": "Hash of the redacted entry. The same id with another digest: the item changed.",
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "key": { "type": "string", "minLength": 1 },
        "class": { "enum": ["endpoint", "credential", "tls", "code-exec", "other"] },
        "shown": {
          "description": "For `endpoint` only: the URL origin. Never a credential value.",
          "type": "string"
        }
      }
    },
    "inventory": {
      "description": "Security inventory: every MCP server, hook, permission and environment override in the repository, whether or not an agent loads it. Never holds credential values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mcpServers", "hooks", "permissions", "env", "incomplete"],
      "properties": {
        "mcpServers": {
          "description": "Sorted by id.",
          "type": "array",
          "items": { "$ref": "#/$defs/mcpServerItem" }
        },
        "hooks": {
          "description": "Sorted by id.",
          "type": "array",
          "items": { "$ref": "#/$defs/hookItem" }
        },
        "permissions": {
          "description": "Sorted by id.",
          "type": "array",
          "items": { "$ref": "#/$defs/permissionItem" }
        },
        "env": {
          "description": "Sorted by id.",
          "type": "array",
          "items": { "$ref": "#/$defs/envItem" }
        },
        "incomplete": {
          "description": "Config files that could not be analyzed, so items may be missing.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gateClass": { "enum": ["mcp", "mcp-unpinned", "permissions", "hooks", "env", "unicode"] },
    "itemDiff": {
      "description": "Ids added, removed and changed between the baseline and this scan, sorted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fields"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "planDelta": {
      "description": "Change in one load plan present in both reports.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "cwd", "entries", "skipped", "startupTokens", "limits"],
      "properties": {
        "agent": { "$ref": "#/$defs/contextAgent" },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "entries": { "$ref": "#/$defs/itemDiff" },
        "skipped": { "$ref": "#/$defs/itemDiff" },
        "startupTokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "#/$defs/count" },
            "after": { "$ref": "#/$defs/count" }
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "subject", "before", "after", "limit"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "subject": { "$ref": "#/$defs/relativePath" },
              "label": { "type": "string", "minLength": 1 },
              "before": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
              "after": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
              "limit": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }
            }
          }
        }
      }
    },
    "gateHit": {
      "description": "One change that trips the gate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id", "change", "summary"],
      "properties": {
        "class": { "$ref": "#/$defs/gateClass" },
        "id": {
          "description": "The inventory item id; for `unicode`, the finding's fingerprint.",
          "type": "string",
          "minLength": 1
        },
        "change": { "enum": ["added", "changed"] },
        "summary": {
          "description": "One line for the pull request summary. Untrusted text.",
          "type": "string"
        }
      }
    },
    "baselineDiff": {
      "description": "Comparison with the `--baseline` report. Paths are compared after removing each report's `pathBase`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["against", "findings", "inventory", "context", "gate"],
      "properties": {
        "against": {
          "description": "The baseline report's tool and rule set versions.",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "ruleset", "sameRuleset", "newRules"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "ruleset": { "type": "string", "minLength": 1 },
            "sameRuleset": { "type": "boolean" },
            "newRules": {
              "description": "Rules this scan ran that are newer than the baseline's rule set, sorted. Their findings count as new; reports label them \"new rule\".",
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["new", "unchanged", "resolved"],
          "properties": {
            "new": { "$ref": "#/$defs/count" },
            "unchanged": { "$ref": "#/$defs/count" },
            "resolved": {
              "description": "Baseline findings with no match in this scan, sorted by path.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ruleId", "path", "fingerprint"],
                "properties": {
                  "ruleId": { "type": "string", "minLength": 1 },
                  "path": { "$ref": "#/$defs/path" },
                  "fingerprint": { "type": "string", "pattern": "^[0-9a-f]+:[1-9][0-9]*$" }
                }
              }
            }
          }
        },
        "inventory": { "$ref": "#/$defs/itemDiff" },
        "context": {
          "description": "Only for (agent, cwd) pairs present in both reports.",
          "type": "array",
          "items": { "$ref": "#/$defs/planDelta" }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classes", "hits"],
          "properties": {
            "classes": {
              "type": "array",
              "items": { "$ref": "#/$defs/gateClass" },
              "uniqueItems": true
            },
            "hits": {
              "description": "Changes that trip the gate. Removals never do.",
              "type": "array",
              "items": { "$ref": "#/$defs/gateHit" }
            }
          }
        }
      }
    }
  }
}
